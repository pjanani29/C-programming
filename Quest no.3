#include <stdio.h>

int main() {
    int total, x, y;
    scanf("%d %d %d", &total, &x, &y);

    int benShare = total * x / 100;            // Long Ben's x%
    int remaining = total - benShare;

    int blackbeardShare = remaining * y / 100; // Blackbeard's y% of the remaining
    remaining = remaining - blackbeardShare;

    int eachPirate = remaining / 3;            // other 3 pirates share equally
    // leftover coins (remaining % 3) are thrown into the sea

    printf("%d\n%d\n%d\n", benShare, blackbeardShare, eachPirate);
    return 0;
}
